{% extends 'base.html.twig' %}

{% block title %}FiduFakt - Die E-Rechnungs API für ZUGFeRD & XRechnung{% endblock %}

{% block body %}
    <div x-data="{ monthly: true }" class="bg-white">

        {# 1. Hero Sektion #}
        <header class="relative overflow-hidden bg-white pt-16 pb-24 lg:pt-32">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                <span class="inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10 mb-6">
                    Bereit für die E-Rechnungspflicht 2025
                </span>
                    <h1 class="text-5xl font-extrabold tracking-tight text-gray-900 sm:text-6xl">
                        E-Rechnungen per API <br/>
                        <span class="text-indigo-600 font-black">einfach automatisiert.</span>
                    </h1>
                    <p class="mt-6 text-lg leading-8 text-gray-600 max-w-2xl mx-auto">
                        Integriere ZUGFeRD und XRechnung in wenigen Minuten in deine Software. Konform, sicher und blitzschnell.
                    </p>
                    <div class="mt-10 flex items-center justify-center gap-x-6">
                        <a href="#pricing" class="rounded-xl bg-indigo-600 px-8 py-4 text-sm font-bold text-white shadow-sm hover:bg-indigo-500 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                            Jetzt Pläne vergleichen
                        </a>
                        <a href="/api/docs" target="_blank" class="text-sm font-semibold leading-6 text-gray-900 hover:text-indigo-600 transition">
                            API Dokumentation <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <div class="bg-white border-y border-gray-100 py-6">
            <div class="max-w-7xl mx-auto px-4 flex justify-center space-x-12 opacity-50 grayscale">
                <span class="text-sm font-bold tracking-widest text-gray-500 uppercase italic">100% DSGVO-konform</span>
                <span class="text-sm font-bold tracking-widest text-gray-500 uppercase italic">ZUGFeRD 2.2</span>
                <span class="text-sm font-bold tracking-widest text-gray-500 uppercase italic">GoBD zertifiziert</span>
                <span class="text-sm font-bold tracking-widest text-gray-500 uppercase italic">Serverstandort Deutschland</span>
            </div>
        </div>

        {# 2. Features / Vorteile #}
        <section class="py-24 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-3">
                    <div class="flex flex-col items-start">
                        <div class="rounded-lg bg-indigo-600 p-2 mb-4 text-white">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Rechtssicher</h3>
                        <p class="mt-2 text-gray-600">Vollständig konform mit der EN 16931. Erzeuge XRechnungen und ZUGFeRD-Dateien für Behörden und B2B.</p>
                    </div>
                    <div class="flex flex-col items-start">
                        <div class="rounded-lg bg-indigo-600 p-2 mb-4 text-white">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Blitzschnell</h3>
                        <p class="mt-2 text-gray-600">Keine komplizierten XML-Strukturen. Schicke uns einfache JSON-Daten, wir erledigen den Rest in Millisekunden.</p>
                    </div>
                    <div class="flex flex-col items-start">
                        <div class="rounded-lg bg-indigo-600 p-2 mb-4 text-white">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Archivierung</h3>
                        <p class="mt-2 text-gray-600">Alle erstellten Rechnungen werden sicher gespeichert und können jederzeit über die API oder das Dashboard abgerufen werden.</p>
                    </div>
                </div>
            </div>
        </section>

        {# 3. Code-Vorschau Sektion #}
        <section class="py-24 bg-gray-900 overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

                    {# Linke Seite: Text #}
                    <div>
                        <h2 class="text-base font-semibold leading-7 text-indigo-400 uppercase tracking-widest">Für Entwickler</h2>
                        <p class="mt-2 text-4xl font-black text-white sm:text-5xl">In 5 Minuten integriert.</p>
                        <p class="mt-6 text-lg leading-8 text-gray-300">
                            Sende uns deine Rechnungsdaten als strukturiertes JSON. Wir validieren, generieren die XML-Struktur nach EU-Norm und liefern dir das fertige Dokument zurück.
                        </p>

                        <ul class="mt-8 space-y-4 text-gray-400">
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-indigo-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                X-API-KEY Authentication
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-indigo-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                ZUGFeRD & XRechnung Support
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-indigo-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Echtzeit-Validierung der Pflichtangaben
                            </li>
                        </ul>
                    </div>

                    {# Rechte Seite: "Editor" Fenster #}
                    <div class="relative">
                        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-500 opacity-30 blur-lg"></div>
                        <div class="relative bg-[#0d1117] rounded-2xl border border-gray-700 shadow-2xl overflow-hidden font-mono text-xs sm:text-sm">
                            {# Mac-Style Buttons #}
                            <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-800 bg-gray-800/50">
                                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                                <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                                <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                                <span class="ml-2 text-gray-500 text-xs">POST /api/v1/invoice/generate</span>
                            </div>

                            <div class="p-6 overflow-x-auto h-[400px] custom-scrollbar">
                        <pre class="text-indigo-300"><code>{
  <span class="text-white">"invoiceNumber"</span>: <span class="text-green-400">"FIDU-2026-002"</span>,
  <span class="text-white">"rawPayload"</span>: {
    <span class="text-white">"creditor"</span>: {
      <span class="text-white">"account"</span>: { <span class="text-white">"iban"</span>: <span class="text-green-400">"DE123456..."</span> },
      <span class="text-white">"institution"</span>: { <span class="text-white">"bic"</span>: <span class="text-green-400">"ABCDEFF1..."</span> }
    },
    <span class="text-white">"customer"</span>: {
      <span class="text-white">"name"</span>: <span class="text-green-400">"Kunde Test GmbH"</span>,
      <span class="text-white">"addressLineOne"</span>: <span class="text-green-400">"Teststrasse 12"</span>,
      <span class="text-white">"postCode"</span>: <span class="text-green-400">"12345"</span>,
      <span class="text-white">"city"</span>: <span class="text-green-400">"Berlin"</span>,
      <span class="text-white">"countryCode"</span>: <span class="text-green-400">"DE"</span>,
      <span class="text-white">"email"</span>: <span class="text-green-400">"max@test.de"</span>,
      <span class="text-white">"phone"</span>: <span class="text-green-400">"+491791234567"</span>,
      <span class="text-white">"vatId"</span>: <span class="text-green-400">"122/34/56"</span>
    },
    <span class="text-white">"items"</span>: [
      {
        <span class="text-white">"description"</span>: <span class="text-green-400">"KI Beratung"</span>,
        <span class="text-white">"quantity"</span>: <span class="text-amber-400">2</span>,
        <span class="text-white">"price"</span>: <span class="text-amber-400">150.00</span>
      }
    ]
  }
}</code></pre>
                            </div>

                            <div class="bg-indigo-600/10 border-t border-indigo-500/20 px-6 py-3">
                                <div class="flex justify-between items-center">
                                    <div class="flex items-center">
                                        <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
                                        <span class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest">201 Created</span>
                                    </div>
                                    <span class="text-indigo-400/50 text-[10px]">64ms</span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 flex items-start space-x-2 text-gray-400 text-xs px-2 leading-relaxed">
                            <svg class="w-4 h-4 text-indigo-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>
                                <strong class="text-indigo-400 font-semibold">Tipp:</strong>
                                Dieses JSON erzeugt automatisch ein hybrides PDF/A-3 Dokument mit integriertem XML – voll kompatibel mit Leitweg-ID Anforderungen für Behörden.
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        {# 4. Pricing Sektion #}
        {{ include('components/_pricing_section.html.twig', {
            is_dashboard: false,
            user_plan: null
        }) }}

        {# 5. Call to Action Footer #}
        <section class="bg-indigo-700 py-16">
            <div class="max-w-4xl mx-auto px-4 text-center">
                <h2 class="text-3xl font-bold text-white mb-6">Bereit für die Zukunft der Rechnungsstellung?</h2>
                <p class="text-indigo-100 mb-10 text-lg">Keine Einrichtungsgebühr. Keine versteckten Kosten. <br/>Jederzeit kündbar.</p>
                <a href="{{ path('register') }}" class="bg-white text-indigo-700 px-10 py-4 rounded-xl font-black hover:bg-indigo-50 transition">
                    Kostenlosen Account erstellen
                </a>
            </div>
        </section>

    </div>
{% endblock %}
