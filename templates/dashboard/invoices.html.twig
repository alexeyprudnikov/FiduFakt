{# templates/dashboard/invoices.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Meine Rechnungen - FiduFakt{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto px-4 py-12" x-data="{
    payInvoice(id) {
        if(!confirm('Rechnung als bezahlt markieren?')) return;
        fetch(`/api/v1/invoice/${id}/pay`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({})
        })
        .then(res => res.ok ? window.location.reload() : alert('Fehler beim Aktualisieren'))
    }
}">
        <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-black text-gray-900 tracking-tight">Deine Rechnungen</h1>
                <p class="text-gray-500 mt-1">Übersicht aller generierten ZUGFeRD & XRechnungen.</p>
            </div>
        </div>

        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                <tr class="bg-gray-50/50 text-gray-400 text-[11px] uppercase tracking-widest font-black">
                    <th class="px-8 py-4">Datum / Nummer</th>
                    <th class="px-8 py-4">Empfänger</th>
                    <th class="px-8 py-4">Betrag (Brutto)</th>
                    <th class="px-8 py-4">Status</th>
                    <th class="px-8 py-4 text-right">Aktion</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                {% for invoice in invoices %}
                    <tr class="hover:bg-gray-50/50 transition-colors">
                        <td class="px-8 py-5">
                            <div class="text-sm font-bold text-gray-900">{{ invoice.createdAt|date('d.m.Y') }}</div>
                            <div class="text-[10px] text-gray-400 font-mono mt-0.5 tracking-tight">Re-Nr: {{ invoice.invoiceNumber }}</div>
                        </td>
                        <td class="px-8 py-5">
                            {# Zugriff auf rawPayload['customer']['name'] #}
                            <div class="text-sm text-gray-700 font-medium">
                                {{ invoice.rawPayload.customer.name|default('Kein Name') }}
                            </div>
                            <div class="text-[10px] text-gray-400">
                                {{ invoice.rawPayload.customer.city|default('-') }}
                            </div>
                        </td>
                        <td class="px-8 py-5">
                            <div class="text-sm font-black text-gray-900">
                                {{ invoice.totalAmount|number_format(2, ',', '.') }} €
                            </div>
                        </td>
                        <td class="px-8 py-5">
                            {# Prüfung gegen den Enum Backing Value (z.B. 'paid') #}
                            {% if invoice.status.value == 'paid' %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-black bg-green-100 text-green-700 uppercase">Bezahlt</span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-black bg-amber-100 text-amber-700 uppercase">Offen</span>
                            {% endif %}
                        </td>
                        <td class="px-8 py-5 text-right flex justify-end items-center gap-3">
                            {# Pay Button nur wenn nicht bezahlt #}
                            {% if invoice.status.value != 'paid' %}
                                <button @click="payInvoice('{{ invoice.id }}')"
                                        class="text-[11px] font-black text-indigo-500 hover:text-indigo-700 uppercase tracking-tighter transition-colors">
                                    Bezahlen
                                </button>
                            {% endif %}

                            {# Download Icon-Button mit Tooltip (Rechtsbündig) #}
                            <div x-data="{ tooltip: false }" class="relative inline-flex items-center">
                                <a href="/api/v1/invoice/{{ invoice.id }}/download"
                                   @mouseenter="tooltip = true"
                                   @mouseleave="tooltip = false"
                                   @click="tooltip = false"
                                   class="inline-flex items-center justify-center p-2.5 bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white rounded-xl transition-all duration-200 border border-indigo-100 shadow-sm group"
                                >
                                    <svg class="w-5 h-5 transition-transform group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                    </svg>
                                </a>

                                {# Tooltip Box - Jetzt nach rechts ausgerichtet (right-0) #}
                                <div x-show="tooltip"
                                     x-transition:enter="transition ease-out duration-200"
                                     x-transition:enter-start="opacity-0 transform translate-y-1"
                                     x-transition:enter-end="opacity-100 transform translate-y-0"
                                     x-transition:leave="transition ease-in duration-150"
                                     x-transition:leave-start="opacity-100 transform translate-y-0"
                                     x-transition:leave-end="opacity-0 transform translate-y-1"
                                     class="absolute bottom-full mb-3 right-0 z-50 px-3 py-1.5 bg-gray-900 text-white text-[10px] font-bold rounded-lg shadow-xl whitespace-nowrap pointer-events-none"
                                     style="display: none;"
                                >
                                    ZUGFeRD PDF/XML laden
                                    {# Tooltip Pfeil - Jetzt ebenfalls rechts positioniert #}
                                    <div class="absolute top-full right-3 border-4 border-transparent border-t-gray-900"></div>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="px-8 py-12 text-center">
                            <div class="text-gray-300 mb-2">
                                <svg class="w-12 h-12 mx-auto mb-4 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                <p class="text-sm font-medium">Noch keine Rechnungen vorhanden.</p>
                            </div>
                            <a href="/api/docs" target="_blank" class="text-indigo-400 font-bold text-xs uppercase tracking-widest hover:underline">API-Dokumentation öffnen</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
