{% extends 'base.html.twig' %}

{% block title %}E-Mail prüfen - FiduFakt{% endblock %}

{% block body %}
    <div class="auth-card">
        <div class="icon-circle">
            <i class="fas fa-paper-plane"></i>
        </div>

        <h1>Postfach prüfen!</h1>
        <p>Wir haben einen magischen Login-Link an <strong>{{ email }}</strong> gesendet.</p>

        <div class="instructions">
            <p>1. Öffnen Sie Ihre E-Mail-App.<br>
                2. Klicken Sie auf den Button <strong>"Bei FiduFakt anmelden"</strong>.<br>
                3. Sie werden automatisch eingeloggt.</p>
        </div>

        <div class="actions">
            {# Kleiner UX-Hack: Direkter Link zu gängigen Providern #}
            {% if 'gmail.com' in email %}
                <a href="https://mail.google.com" target="_blank" class="btn btn-primary">Gmail öffnen</a>
            {% elseif 'outlook.' in email or 'hotmail.' in email %}
                <a href="https://outlook.live.com" target="_blank" class="btn btn-primary">Outlook öffnen</a>
            {% endif %}

            <a href="{{ path('register') }}" class="btn btn-link">Andere E-Mail verwenden</a>
        </div>

        <p class="footer-note">Nichts erhalten? Schauen Sie kurz im Spam-Ordner nach.</p>
    </div>

    <style>
        .auth-card { text-align: center; max-width: 450px; margin: 4rem auto; padding: 2rem; border: 1px solid #eee; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .icon-circle { font-size: 3rem; color: #4F46E5; margin-bottom: 1rem; }
        .instructions { background: #f9fafb; padding: 1.5rem; border-radius: 8px; margin: 1.5rem 0; text-align: left; }
        .btn { display: inline-block; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; margin: 0.5rem; }
        .btn-primary { background: #4F46E5; color: white; }
        .btn-link { color: #6b7280; font-size: 0.9rem; }
    </style>
{% endblock %}
